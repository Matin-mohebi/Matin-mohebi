{
  "name": "matin-ai",
  "productName": "Matin AI",
  "version": "1.5.0",
  "description": "Matin AI — دستیار هوشمند فارسی — بدون توکن، بدون ثبت‌نام | Persian AI assistant — zero config, no token",
  "main": "main.js",
  "author": "Matin-mohebi <https://github.com/Matin-mohebi>",
  "license": "MIT",
  "scripts": {
    "copy-ui": "node copy-ui.js",
    "start": "npm run copy-ui && electron .",
    "dist": "npm run copy-ui && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ir.matincode.matinai",
    "productName": "Matin AI",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json", "app-ui/**/*"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "icon": "build-res/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "zip"],
      "category": "Utility",
      "icon": "build-res/icon.png"
    },
    "mac": {
      "target": [{ "target": "zip", "arch": ["x64", "arm64"] }],
      "icon": "build-res/icon.png",
      "identity": null,
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
